{
  "name": "precisionpdf-learning",
  "displayName": "PrecisionPDF Learning Mode",
  "description": "Local PDF reading and optional Copilot-powered explanations for PrecisionPDF-MCP",
  "version": "0.6.2",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onCommand:precisionpdfLearning.open"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "precisionpdfLearning.open",
        "title": "PrecisionPDF: Open Learning Mode"
      }
    ],
    "configuration": {
      "title": "PrecisionPDF Learning Mode",
      "properties": {
        "precisionpdfLearning.repositoryPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the local PrecisionPDF-MCP Python repository. When missing, the extension prompts you to select it once."
        },
        "precisionpdfLearning.uvPath": {
          "type": "string",
          "default": "uv",
          "description": "Path to the uv executable on Fedora or another system."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package:vsix": "vsce package --no-dependencies"
  },
  "publisher": "tobiasguta",
  "repository": {
    "type": "git",
    "url": "https://github.com/tobiasGuta/PrecisionPDF-MCP.git",
    "directory": "vscode-learning"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2"
  }
}
